<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cours — NetRevision</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">

<style>

/* =====================================
   1. VARIABLES ET RESET
===================================== */

:root {
    --black: #171719;
    --green: #006663;
    --mint: #a3ffa3;
    --yellow: #ffd629;
    --white: #ffffff;
    --background: #f4f8f7;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Arial', 'Segoe UI', sans-serif;
}

html { scroll-behavior: smooth; }

body {
    background: var(--background);
    color: var(--black);
    min-height: 100vh;
    overflow-x: hidden;
}

/* =====================================
   2. NAVIGATION
===================================== */

.navbar {
    width: 100%;
    height: 65px;
    padding: 0 4.5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--black);
    border-bottom: 1px solid #ffffff25;
    position: relative;
    z-index: 100;
}

.nav-logo {
    color: var(--mint);
    font-size: 36px;
    font-weight: 900;
    letter-spacing: -2px;
    text-decoration: none;
}

.nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 40px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-size: 16px;
    font-weight: 800;
    transition: .25s;
}

.nav-links a:hover,
.nav-links a.active-page {
    color: var(--mint);
}

.nav-links a.active-page {
    border-bottom: 3px solid var(--mint);
    padding-bottom: 4px;
}

.nav-links .btn {
    display: inline-block;
    border: none;
    background: var(--yellow);
    color: var(--black);
    padding: 12px 20px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 900;
    cursor: pointer;
    transition: .3s;
}

.nav-links .btn:hover {
    background: var(--mint);
    transform: translateY(-3px);
}

.menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--mint);
    font-size: 30px;
    cursor: pointer;
}

/* =====================================
   3. HERO
===================================== */

.page-hero {
    position: relative;
    z-index: 2;
    background: var(--black);
    color: white;
    text-align: center;
    padding: 30px 20px 0;
    height: 360px;

    clip-path: polygon(0 0, 100% 0, 100% 78%, 0 100%);
}

.hero-eyebrow {
    color: var(--mint);
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.page-hero h1 {
    font-size: clamp(44px, 7vw, 86px);
    font-weight: 1000;
    line-height: .92;
    letter-spacing: -4px;
    margin-bottom: 12px;
}

.page-hero h1 span {
    color: var(--mint);
    font-style: italic;
}

.hero-description {
    font-size: 20px;
    margin-bottom: 18px;
}

.hero-star {
    position: absolute;
    left: 9%;
    top: 70px;
    color: var(--mint);
    font-size: 100px;
    font-weight: bold;
    transform: rotate(15deg);
}

.hero-rays {
    position: absolute;
    right: 12%;
    top: 55px;
    color: var(--mint);
    font-size: 80px;
    transform: rotate(20deg);
}

/* Recherche */

.search-box {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: min(520px, 90%);
    height: 56px;
    padding: 0 22px;
    background: var(--white);
    border: 2px solid var(--yellow);
    border-radius: 40px;
}

.search-box span {
    color: var(--black);
    font-size: 20px;
}

.search-box input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    font-weight: 700;
    color: var(--black);
}

.search-box input::placeholder {
    color: #17171980;
}

/* =====================================
   4. CATALOGUE
===================================== */

.catalog {
    position: relative;
    z-index: 1;
    margin-top: -1px;
    padding: 25px 5.7% 55px;
    background: var(--background);
}

.section-heading {
    text-align: center;
    margin-bottom: 20px;
}

.section-eyebrow {
    color: var(--green);
    font-size: 19px;
    font-weight: 900;
    letter-spacing: 3px;
    margin-bottom: 3px;
}

.section-heading h2 {
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 1000;
    letter-spacing: -2px;
}

.section-heading h2 span { color: var(--green); }

/* Filtres */

.filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
}

.chip {
    border: 2px solid var(--black);
    background: var(--white);
    color: var(--black);
    padding: 10px 22px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 900;
    cursor: pointer;
    transition: .25s;
}

.chip:hover {
    background: var(--mint);
    transform: translateY(-3px);
}

.chip.active {
    background: var(--black);
    color: var(--mint);
}

.result-count {
    text-align: center;
    color: var(--green);
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 1px;
    margin-bottom: 20px;
}

/* Grille */

.course-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1400px;
    margin: 0 auto;
}

.course-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 290px;
    padding: 22px 26px 24px;
    border: 2px solid var(--black);
    border-radius: 14px;
    transition: .3s;
}

.course-card:nth-child(3n+1) {
    background: var(--mint);
    box-shadow: 4px 4px 0 var(--green);
}

.course-card:nth-child(3n+2) {
    background: var(--white);
    box-shadow: 4px 4px 0 var(--yellow);
}

.course-card:nth-child(3n) {
    background: var(--black);
    color: white;
    box-shadow: 4px 4px 0 var(--green);
}

.course-card:hover {
    transform: translateY(-5px);
    box-shadow: 7px 9px 0 var(--black);
}

.course-card:nth-child(3n):hover {
    box-shadow: 7px 9px 0 var(--mint);
}

.course-card.hidden { display: none; }

.badge {
    display: table;
    width: fit-content;
    background: var(--yellow);
    color: var(--black);
    padding: 6px 12px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 900;
    margin-bottom: 10px;
}

.card-number {
    display: block;
    color: var(--green);
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.course-card:nth-child(3n) .card-number { color: var(--mint); }

.course-card h3 {
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -.5px;
    line-height: 1.1;
    margin-bottom: 8px;
    max-width: 75%;
}

.course-card p {
    font-size: 16px;
    line-height: 1.4;
    margin-bottom: 14px;
    max-width: 85%;
}

.card-emoji {
    position: absolute;
    right: 20px;
    top: 18px;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    font-size: 32px;
    border: 2px solid var(--black);
    border-radius: 50%;
    background: var(--yellow);
}

.card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
}

.card-meta span {
    border: 2px solid currentColor;
    border-radius: 30px;
    padding: 4px 11px;
    font-size: 12px;
    font-weight: 900;
}

/* Progression */

.progress {
    margin-top: auto;
    margin-bottom: 14px;
}

.progress-label {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 900;
    margin-bottom: 5px;
}

.progress-bar {
    height: 10px;
    border: 2px solid currentColor;
    border-radius: 20px;
    overflow: hidden;
}

.progress-bar i {
    display: block;
    height: 100%;
    background: var(--yellow);
}

.course-card .btn {
    display: inline-block;
    width: fit-content;
    margin-top: auto;
    background: var(--black);
    color: white;
    padding: 9px 28px;
    border-radius: 30px;
    font-size: 15px;
    font-weight: 900;
    text-decoration: none;
    transition: .3s;
}

.progress + .btn { margin-top: 0; }

.course-card:nth-child(3n) .btn {
    background: var(--mint);
    color: var(--black);
}

.course-card .btn:hover {
    background: var(--green);
    color: var(--mint);
}

.course-card:nth-child(3n) .btn:hover {
    background: var(--yellow);
    color: var(--black);
}

/* Aucun résultat */

.empty-state {
    display: none;
    max-width: 520px;
    margin: 20px auto 0;
    padding: 30px;
    text-align: center;
    background: var(--white);
    border: 2px solid var(--black);
    border-radius: 14px;
    box-shadow: 4px 4px 0 var(--yellow);
}

.empty-state.show { display: block; }

.empty-state h3 {
    font-size: 26px;
    font-weight: 900;
    margin-bottom: 6px;
}

/* Bandeau parcours */

.path-banner {
    position: relative;
    max-width: 1400px;
    margin: 28px auto 0;
    padding: 26px 32px;
    background: var(--black);
    color: white;
    border: 2px solid var(--black);
    border-radius: 14px;
    box-shadow: 4px 4px 0 var(--green);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}

.path-banner .card-number { color: var(--mint); }

.path-banner h3 {
    font-size: 27px;
    font-weight: 900;
    letter-spacing: -.5px;
    margin-bottom: 3px;
}

.path-banner p { font-size: 17px; }

.path-banner .link {
    color: var(--mint);
    text-decoration: none;
    font-size: 19px;
    font-weight: 900;
    border-bottom: 2px solid var(--mint);
    padding-bottom: 7px;
}

.path-banner .link:hover {
    color: var(--yellow);
    border-color: var(--yellow);
}

/* =====================================
   5. FOOTER (style Breaver)
===================================== */

.site-footer {
    background: var(--black);
    color: var(--black);
    overflow: hidden;
}

.footer-scene {
    position: relative;
    height: clamp(170px, 23vw, 330px);
    margin-bottom: -1px;
}
